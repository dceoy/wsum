{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/weekly-web-monitor/audit.schema.json",
  "title": "Content-free audit record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_type",
    "target_id",
    "outcome",
    "occurred_at",
    "run_id",
    "metadata"
  ],
  "properties": {
    "event_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,99}$"
    },
    "target_id": {"type": "string", "maxLength": 128},
    "outcome": {"enum": ["attempted", "failed", "skipped", "succeeded"]},
    "occurred_at": {"type": "string", "format": "date-time"},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "metadata": {
      "type": "object",
      "propertyNames": {
        "allOf": [
          {"pattern": "^[a-z][a-z0-9_]{0,63}$"},
          {
            "not": {
              "pattern": "body|content|credential|html|password|payload|secret|text|token|webhook"
            }
          }
        ]
      },
      "additionalProperties": {"type": "string", "maxLength": 200}
    }
  }
}
