{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/weekly-web-monitor/outbox.schema.json",
  "title": "Optional GAS Outbox record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "target_id",
    "payload",
    "status",
    "attempt_count",
    "created_at",
    "updated_at",
    "next_attempt_at",
    "last_error"
  ],
  "properties": {
    "event_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "target_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "payload": {"type": "string", "maxLength": 4000},
    "status": {"enum": ["pending", "sending", "sent", "retry", "poison"]},
    "attempt_count": {"type": "integer", "minimum": 0, "maximum": 100},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "next_attempt_at": {
      "oneOf": [
        {"const": ""},
        {"type": "string", "format": "date-time"}
      ]
    },
    "last_error": {"type": "string", "maxLength": 200}
  }
}
