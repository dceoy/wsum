{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/weekly-web-monitor/notification.schema.json",
  "title": "Notification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "target_id",
    "status",
    "notified_at",
    "kind",
    "last_error"
  ],
  "properties": {
    "event_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "target_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "status": {"enum": ["pending", "sent", "failed", "suppressed"]},
    "notified_at": {
      "oneOf": [
        {"const": ""},
        {"type": "string", "format": "date-time"}
      ]
    },
    "kind": {"enum": ["change", "failure"]},
    "last_error": {"type": "string", "maxLength": 200}
  }
}
