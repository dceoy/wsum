{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/weekly-web-monitor/diff.schema.json",
  "title": "Deterministic diff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "result",
    "change_score",
    "significance",
    "changed_ratio",
    "sections",
    "truncated",
    "scoring_reasons",
    "should_summarize",
    "should_notify"
  ],
  "properties": {
    "result": {
      "enum": ["unchanged", "baseline_created", "minor", "candidate_material"]
    },
    "change_score": {"type": "integer", "minimum": 0, "maximum": 100},
    "significance": {"enum": ["none", "minor", "moderate", "high"]},
    "changed_ratio": {"type": "number", "minimum": 0, "maximum": 1},
    "sections": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["section_id", "anchor", "kind", "context", "before", "after"],
        "properties": {
          "section_id": {"type": "string", "pattern": "^[a-f0-9]{16}$"},
          "anchor": {"type": "string", "maxLength": 300},
          "kind": {"enum": ["added", "removed", "modified"]},
          "context": {
            "type": "array",
            "items": {"type": "string", "maxLength": 12000}
          },
          "before": {
            "type": "array",
            "items": {"type": "string", "maxLength": 12000}
          },
          "after": {
            "type": "array",
            "items": {"type": "string", "maxLength": 12000}
          }
        }
      }
    },
    "truncated": {"type": "boolean"},
    "scoring_reasons": {
      "type": "array",
      "items": {"type": "string", "maxLength": 100}
    },
    "should_summarize": {"type": "boolean"},
    "should_notify": {"const": false}
  }
}
