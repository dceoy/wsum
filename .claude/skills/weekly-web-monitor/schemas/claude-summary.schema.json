{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/weekly-web-monitor/claude-summary.schema.json",
  "title": "Validated Claude change summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "material",
    "significance",
    "summary_ja",
    "evidence",
    "recommended_action_ja",
    "notification_text_ja",
    "source_url"
  ],
  "properties": {
    "material": {"type": "boolean"},
    "significance": {"enum": ["minor", "moderate", "high"]},
    "summary_ja": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "[ぁ-んァ-ヶ一-龯]"
    },
    "evidence": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["section_id", "claim_ja", "before", "after"],
        "properties": {
          "section_id": {"type": "string", "maxLength": 64},
          "claim_ja": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "[ぁ-んァ-ヶ一-龯]"
          },
          "before": {"type": "string", "maxLength": 500},
          "after": {"type": "string", "maxLength": 500}
        }
      }
    },
    "recommended_action_ja": {"type": "string", "maxLength": 300},
    "notification_text_ja": {"type": "string", "maxLength": 1500},
    "source_url": {"type": "string", "format": "uri", "pattern": "^https?://"}
  },
  "allOf": [
    {
      "if": {"properties": {"material": {"const": true}}},
      "then": {
        "properties": {
          "evidence": {"minItems": 1},
          "notification_text_ja": {
            "minLength": 1,
            "pattern": "[ぁ-んァ-ヶ一-龯]"
          }
        }
      },
      "else": {
        "properties": {
          "notification_text_ja": {"maxLength": 0}
        }
      }
    }
  ]
}
